# Canonical site URL, no trailing slash. Used for canonical links, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form email delivery via Resend (free plan: 3,000 emails/month, no card).
# 1. Sign up at resend.com with the inbox that should receive briefs (hubtohub12@gmail.com)
# 2. API Keys > Create API Key (Sending access) > paste it here. Server-side only, never exposed.
RESEND_API_KEY=
# Optional. Where briefs go (defaults to the site email in content/site.json).
CONTACT_TO_EMAIL=
# Optional. Leave empty to use Resend's shared sender, which can only deliver to your own Resend account email.
# After verifying your own domain in Resend, set e.g. "HTH Website <website@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Booking calendar embed URL (https). Any free scheduler works: Cal.com, Calendly, TidyCal, or GoHighLevel.
BOOKING_EMBED_URL=
