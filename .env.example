# Canonical site URL, no trailing slash. Used for canonical links, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# GoHighLevel inbound webhook that receives contact form submissions (server-side only, never exposed).
# GHL: Automation > Workflows > Create workflow > Trigger: "Inbound Webhook" > copy the URL.
GHL_WEBHOOK_URL=

# GoHighLevel booking calendar embed URL (must be https).
# GHL: Calendars > your calendar > Share > copy the embed/iframe "src" URL.
GHL_CALENDAR_EMBED_URL=
